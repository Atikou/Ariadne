{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/core/agent/**/*.ts",
    "src/renderer/src/core/conversations/**/*.ts",
    "src/renderer/src/core/events/**/*.ts",
    "src/renderer/src/core/runtime/**/*.ts",
    "src/renderer/src/app/module-popout-policy.ts",
    "src/renderer/src/app/theme-sync.ts",
    "src/renderer/src/modules/chat/permission-decision-policy.ts",
    "src/renderer/src/modules/chat/MarkdownMessage.tsx",
    "src/renderer/src/modules/settings/local-model-roots.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
