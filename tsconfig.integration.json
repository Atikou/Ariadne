{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "jsx": "react-jsx", "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true,
    "baseUrl": ".", "paths": { "@shared/*": ["app/src/shared/*"], "@renderer/*": ["app/src/renderer/src/*"] }
  },
  "include": ["tests/integration/**/*.ts", "vitest.integration.config.ts", "app/src/preload/index.d.ts"]
}
