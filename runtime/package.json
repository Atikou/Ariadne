{
  "name": "@ariadne/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portless Agent runtime for the Ariadne desktop application",
  "engines": {
    "node": ">=24.16.0"
  },
  "main": "dist/entry/runtime-process.js",
  "files": [
    "dist/",
    "config/",
    "scripts/model-runtime/"
  ],
  "scripts": {
    "migrate:productivity:v1-v2": "node dist/cli/migrate-productivity-v1-v2.js",
    "build": "node ../scripts/clean-typescript-output.mjs runtime && tsc -p tsconfig.json && node scripts/write-build-manifest.mjs",
    "verify:tool-artifacts": "node dist/cli/verify-first-party-tool-artifacts.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=4",
    "start": "node dist/entry/runtime-process.js",
    "headless": "node dist/entry/headless.js",
    "dev": "tsx src/entry/headless.ts",
    "models:check": "tsx src/cli/check-models.ts",
    "accept:model-restart:local": "tsx src/cli/accept-model-restart.ts --target local",
    "accept:model-restart:remote": "tsx src/cli/accept-model-restart.ts --target remote",
    "accept:memory-index:local": "tsx src/cli/accept-memory-index-local.ts",
    "accept:subagent-provider": "tsx src/cli/accept-subagent-provider.ts",
    "models:runtime:setup": "node scripts/setup-model-runtimes.mjs",
    "sandbox:native:build": "node scripts/publish-windows-sandbox.mjs",
    "sandbox:status": "tsx src/cli/sandbox.ts status",
    "sandbox:setup": "tsx src/cli/sandbox.ts setup",
    "agent-control:migrate:v5-v6": "tsx src/cli/migrate-agent-control-v5-v6.ts",
    "agent-control:migrate:v6-v7": "tsx src/cli/migrate-agent-control-v6-v7.ts",
    "storage:normalize:agent": "tsx src/cli/normalize-agent-database.ts",
    "storage:normalize:model": "tsx src/cli/normalize-model-database.ts",
    "storage:normalize:protocol": "tsx src/cli/normalize-communication-contract.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@ariadne/agent-core": "file:../packages/agent-core",
    "@ariadne/component-contracts": "file:../packages/component-contracts",
    "@ariadne/live-work": "file:../packages/live-work",
    "@ariadne/protocol": "file:../packages/protocol",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "gpt-tokenizer": "^4.0.0",
    "node-llama-cpp": "^3.19.0",
    "node-pty": "^1.1.0",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "typescript-language-server": "6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "vitest": "^4.1.0"
  }
}
