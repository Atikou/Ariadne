{
  "name": "@ariadne/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portless Agent runtime for the Ariadne desktop application",
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/entry/runtime-process.js",
  "files": [
    "dist/",
    "config/",
    "scripts/model-runtime/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-build-manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/entry/runtime-process.js",
    "headless": "node dist/entry/headless.js",
    "dev": "tsx src/cli/main.ts",
    "models:check": "tsx src/cli/check-models.ts",
    "models:runtime:setup": "node scripts/setup-model-runtimes.mjs",
    "sandbox:native:build": "node scripts/publish-windows-sandbox.mjs",
    "sandbox:status": "tsx src/cli/sandbox.ts status",
    "sandbox:setup": "tsx src/cli/sandbox.ts setup",
    "storage:status": "tsx src/cli/storage.ts status",
    "storage:cleanup": "tsx src/cli/storage.ts cleanup"
  },
  "dependencies": {
    "@ariadne/protocol": "file:../packages/protocol",
    "@lancedb/lancedb": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "node-llama-cpp": "^3.19.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
